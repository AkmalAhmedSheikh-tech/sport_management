# Copy this file to .env and fill in your own values. Never commit .env.
FLASK_APP=run.py

SECRET_KEY=change-me-to-a-long-random-string

# Database credentials (URL-encode special characters in the password, e.g. @ -> %40)
DB_USER=sportsuser
DB_PASS=your-db-password
DB_HOST=localhost
DB_NAME=sports_league_manager
